{
  "name": "house-layout",
  "version": "1.0.0",
  "private": true,
  "description": "在瀏覽器裡畫室內平面配置圖：匯入房屋底圖、拖拉家具、比較多個設計方案",
  "license": "MIT",
  "author": "Josh Tsai (https://github.com/u9951064)",
  "repository": {
    "type": "git",
    "url": "https://github.com/u9951064/house-layout.git"
  },
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs 8000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "test": "node --test tests/*.test.mjs",
    "test:install": "playwright install chromium-headless-shell",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:en": "node scripts/screenshots.mjs en",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs 8001 dist",
    "test:dist": "TEST_ROOT=dist node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright": "^1.59.0",
    "prettier": "^3.9.9"
  }
}
